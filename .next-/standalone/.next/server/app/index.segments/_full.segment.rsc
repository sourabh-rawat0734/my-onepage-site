f:["$","$L20",null,{"slice":{"variation":"default","version":"initial","items":[],"primary":{"logo":{"dimensions":{"width":262,"height":70},"alt":null,"copyright":null,"url":"https://images.prismic.io/cb704fc6/yVxROk9bVWFAZLEn_newlogo-1.png?auto=format,compress","id":"yVxROk9bVWFAZLEn","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"nav_links":[{"label":"The Problem","link":{"link_type":"Any"}},{"label":"Platform","link":{"link_type":"Any"}},{"label":"News & Grants","link":{"link_type":"Any"}},{"label":"Our Team","link":{"link_type":"Any"}},{"label":"Grants","link":{"link_type":"Any"}},{"label":"Partners","link":{"link_type":"Any"}},{"label":"Our Journey","link":{"link_type":"Any"}}],"cta_button":{"link_type":"Any"}},"id":"header_navigation$c0f7d6de-d5b8-4b44-aa33-3b91b03feff4","slice_type":"header_navigation","slice_label":null},"index":0,"slices":["$f:props:slice",{"variation":"default","version":"initial","items":[],"primary":{"eyebrow":[{"type":"heading4","text":"Welcome to SymVentra","spans":[],"direction":"ltr"}],"title":[{"type":"heading1","text":"Personalized health starts with your microbiome","spans":[{"start":37,"end":47,"type":"em"}],"direction":"ltr"}],"emphasized_text":[{"type":"heading2","text":"SymVentra transforms gut microbiome and lifestyle data into science-based, personalized guidance for modern health and wellness professionals.","spans":[],"direction":"ltr"}],"description":[],"primary_cta":{"link_type":"Any","key":"e0f6c83d-cf7c-406b-a0d3-4c57c289a639","text":"Learn More"},"main_image":{"dimensions":{"width":360,"height":360},"alt":null,"copyright":null,"url":"https://images.prismic.io/cb704fc6/Ml4mqOpjhbT727dc_hero_img.png?auto=format,compress","id":"Ml4mqOpjhbT727dc","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}}},"id":"headline_cta_image$70737450-439e-4aae-95fc-92f69e6d26eb","slice_type":"headline_cta_image","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"items":[{"icon":{},"headline":"Europe's Largest","subheadline":"Health Cohort Data","description":"Core training dataset model"},{"icon":{},"headline":"Adaptive AI","subheadline":"Continuous Refinement","description":"Evolves as client biology shifts"},{"icon":{},"headline":"B2B Focused","subheadline":"Empowering Experts","description":"Built for professional workflows"},{"icon":{},"headline":"Western EU","subheadline":"Localised Specificity","description":"No imported generalised US models"}]},"id":"icon_headline_columns$73068e8c-42c4-411a-ae06-dd0881a0831a","slice_type":"icon_headline_columns","slice_label":null},{"variation":"default_left_text_right_metric","version":"initial","items":[],"primary":{"eyebrow":[],"headline":[{"type":"heading1","text":"Choose the health future that fits you","spans":[],"direction":"ltr"}],"highlighted_phrase":[{"type":"paragraph","text":"There is no single lifestyle that works for everyone.","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"SymVentra helps you understand how your biology and daily habits work together, so you can make more informed choices for your long-term health and well being.","spans":[],"direction":"ltr"}],"primary_cta":{"link_type":"Any","key":"d82da572-e620-4d99-887a-b62f6819c666","text":"Join The Pilot "},"secondary_cta":{"link_type":"Any","key":"5b44c0e1-b6d3-48cd-b75e-d640e0fdab0e","text":"Partner with Us"},"metric_visualization_image":{"dimensions":{"width":783,"height":928},"alt":null,"copyright":null,"url":"https://images.prismic.io/cb704fc6/FULmo7Z7gmUQB6-c_img1.png?auto=format,compress","id":"FULmo7Z7gmUQB6-c","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"metric_title":[],"metrics_list":[],"tag_list":[],"recommendation_text":[],"note":"“Be among the first to experience SymVentra through our paid pilot programme and enjoy an exclusive Early Adopter discount before our official launch.”"},"id":"headline_description_graph_cta$57c24b70-f362-4d8e-a3d0-6d6555f47656","slice_type":"headline_description_graph_cta","slice_label":null},{"variation":"heading_text_3_column_feature","version":"initial","items":[],"primary":{"eyebrow":"The Problem","heading":[{"type":"heading2","text":"Health advice isn't personal.","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Every day we're told what to eat, how to exercise and how to live healthier. Yet much of this advice is based on population averages, not on you.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Because your biology is unique, the same lifestyle can lead to very different outcomes for different people.","spans":[],"direction":"ltr"}],"features":[{"icon":null,"title":[{"type":"heading3","text":"Gut Microbiome Deep Sequencing Data","spans":[],"direction":"ltr"}],"feature_description":[{"type":"paragraph","text":"Utilizing targeted laboratory diagnostics to parse bacterial architecture and mapping individual specific strain performance metrics","spans":[],"direction":"ltr"}]},{"icon":null,"title":[{"type":"heading3","text":"Lifestyle & Behavioral Data Points","spans":[],"direction":"ltr"}],"feature_description":[{"type":"paragraph","text":"Integrating structured intake logs covering accurate dietary patterns, real-world metabolic expenditure, stress indices, and circadian rhythms.","spans":[],"direction":"ltr"}]},{"icon":null,"title":[{"type":"heading3","text":"European Cohort Predictive AI Engine","spans":[],"direction":"ltr"}],"feature_description":[{"type":"paragraph","text":"Advanced machine learning pattern recognition trained on verified Western European population health cohorts to avoid generic averages.","spans":[],"direction":"ltr"}]}]},"id":"feature_columns_intro$c0060037-7751-4e7f-bd89-1e7b388f5fd9","slice_type":"feature_columns_intro","slice_label":null},{"variation":"image_left_text_right","version":"initial","items":[],"primary":{"section_preheading":[{"type":"paragraph","text":"Our Solution","spans":[{"start":0,"end":12,"type":"strong"}],"direction":"ltr"}],"section_heading":[{"type":"heading2","text":"Understand yourself. Improve what matters.","spans":[],"direction":"ltr"}],"section_description":[{"type":"paragraph","text":"SymVentra combines your microbiome, lifestyle habits and scientific evidence in one easy-to-use platform.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Instead of generic recommendations, you receive personalized insights that help you make practical, sustainable lifestyle choices.","spans":[],"direction":"ltr"}],"visual_block":{"dimensions":{"width":796,"height":687},"alt":null,"copyright":null,"url":"https://images.prismic.io/cb704fc6/KrkTUHNAER1F-YFc_Screenshot-2026-07-07-122109.png?auto=format,compress","id":"KrkTUHNAER1F-YFc","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"visual_caption":[]},"id":"visual_text_split$b1752142-672c-46f9-aea5-4f5b566446ba","slice_type":"visual_text_split","slice_label":null},{"variation":"intro_with_icon_bulletlist","version":"initial","items":[],"primary":{"intro_text":[{"type":"heading3","text":"HOW IT WORKS","spans":[],"direction":"ltr"}],"items":[{"icon":{},"title":[{"type":"heading4","text":"1. Tell us about yourself","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Complete a short questionnaire about your health, lifestyle, and goals on the SymVentra platform.","spans":[],"direction":"ltr"}]},{"icon":{},"title":[{"type":"heading4","text":"2. Track your daily habits","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Use the SymVentra platform for one week to log your meals, sleep, movement and overall well being.","spans":[],"direction":"ltr"}]},{"icon":{},"title":[{"type":"heading4","text":"3. Add your microbiome","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Order your microbiome test, collect your stool sample at home using our easy-to-use collection kit, and send it to our trusted laboratory partner. Once the analysis is complete, your results will be available in the SymVentra platform, providing deeper biological insights.","spans":[],"direction":"ltr"}]},{"icon":{},"title":[{"type":"heading4","text":"4. Discover your patterns","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Our platform combines your biology and lifestyle data to identify meaningful patterns and connections.","spans":[],"direction":"ltr"}]},{"icon":{},"title":[{"type":"heading4","text":"5. Receive personalised guidance","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Get practical recommendations designed around you, not the average person.","spans":[],"direction":"ltr"}]},{"icon":{},"title":[{"type":"heading4","text":"6. Learn over time","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Continue tracking your lifestyle each week and repeat your home stool test every three months. As your biology changes, your insights and recommendations evolve with you.","spans":[],"direction":"ltr"}]}]},"id":"icon_bulletlist_intro$344c1743-820f-44bf-b718-3d942f64a9fe","slice_type":"icon_bulletlist_intro","slice_label":null},{"variation":"image_left_text_right_intro","version":"initial","items":[],"primary":{"eyebrow":[{"type":"paragraph","text":"Platform Preview","spans":[{"start":0,"end":16,"type":"strong"}],"direction":"ltr"}],"title":[{"type":"heading1","text":"Everything in one place.","spans":[{"start":0,"end":24,"type":"strong"}],"direction":"ltr"}],"highlighted_text":[],"main_image":{"dimensions":{"width":572,"height":1024},"alt":null,"copyright":null,"url":"https://images.prismic.io/cb704fc6/ZuS_2nQBzt25glcK_mobileapp.jpg?auto=format,compress","id":"ZuS_2nQBzt25glcK","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"right_title_intro":[{"type":"paragraph","text":"The SymVentra platform helps you:","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Turn microbiome data into dynamic lifestyle guidance. Built for modern health professionals who demand science-backed personalization.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Move beyond legacy diagnostic checklists. Manage your metabolic telemetry dynamically through real-time workflow tracking layers.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Seamlessly integrate gut health analysis into your workflow. Track client lifestyle data, monitor microbiome composition, and deliver highly personalized dietary and stress-management recommendations through a single intuitive dashboard.","spans":[],"direction":"ltr"}]},"id":"two_column_image_text_intro$cfe291f2-0dde-46e5-ba18-2f4d56f7e1bd","slice_type":"two_column_image_text_intro","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"subtitle":[{"type":"paragraph","text":"Intended Ecosystem Applications","spans":[],"direction":"ltr"}],"title":[{"type":"heading2","text":"Built for Precision Health Creators","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Delivering data frameworks that unify researchers, active patient groups, and advanced practitioners under one collaborative roof.","spans":[],"direction":"ltr"}],"feature_groups":[{"group_heading":"Everything in one place.","features":[{"type":"paragraph","text":"The SymVentra platform helps you:","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      Track your daily lifestyle","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      View your microbiome results","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      Discover meaningful patterns","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      Monitor your progress","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      Receive personalized guidance","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      Follow your health journey over time","spans":[],"direction":"ltr"}]},{"group_heading":"What You Receive","features":[{"type":"paragraph","text":"After completing your first assessment, you'll receive:","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      A personalized health overview","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      Lifestyle insights based on your biology","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      Practical recommendations","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      Progress tracking","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      Ongoing health monitoring","spans":[],"direction":"ltr"},{"type":"paragraph","text":"●      New insights as your data grows","spans":[],"direction":"ltr"}]}],"highlighted_text":[{"type":"paragraph","text":"“For professionals who want evidence, not trends. SymVentra is designed to empower wellness providers, nutritionists, and health innovators, not replace them.”","spans":[{"start":0,"end":159,"type":"strong"}],"direction":"ltr"}]},"id":"side_by_side_feature_list$f78fc970-b4da-4d87-be1c-cde4c91bd232","slice_type":"side_by_side_feature_list","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"title":[{"type":"heading2","text":"The Team","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Our mission is to help people make more informed lifestyle decisions by combining biology, technology and scientific evidence into practical everyday guidance.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We envision a future where health recommendations are truly personal,not based on averages, but on the individual.","spans":[],"direction":"ltr"}],"members":[{"photo":{"dimensions":{"width":1273,"height":1280},"alt":null,"copyright":null,"url":"https://images.prismic.io/cb704fc6/CQ1gNf-Y8CLy1MkD_WhatsAppImage2026-07-31at2.36.16PM.jpeg?auto=format,compress","id":"CQ1gNf-Y8CLy1MkD","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"name":"Dr. Arezoo Shajiei-Schotsman","role":"Founder & CEO","bio":[{"type":"paragraph","text":"14+ years in AI & medical imaging","spans":[],"direction":"ltr"}]},{"photo":{"dimensions":{"width":1000,"height":1500},"alt":null,"copyright":null,"url":"https://images.prismic.io/cb704fc6/kqjBODGOhA3MhJsO_WhatsAppImage2026-07-31at2.36.32PM.jpeg?auto=format,compress","id":"kqjBODGOhA3MhJsO","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"name":"Khash Ghavami","role":"AI Lead developer","bio":[{"type":"paragraph","text":"7+ years in machine learning","spans":[],"direction":"ltr"}]},{"photo":{"dimensions":{"width":1000,"height":667},"alt":null,"copyright":null,"url":"https://images.prismic.io/cb704fc6/kkXXOSUxHl0TzSiN_WhatsAppImage2026-07-31at2.37.06PM.jpeg?auto=format,compress","id":"kkXXOSUxHl0TzSiN","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"name":"Asmara van den Steen","role":"Advisory Board","bio":[{"type":"paragraph","text":"2+ years of experience in microbiome and policy","spans":[],"direction":"ltr"}]}]},"id":"core_team_grid$84dfd00d-bc86-4505-940c-d56b4ecbfa37","slice_type":"core_team_grid","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"headline":[],"description":[{"type":"paragraph","text":"Stay up to date with our latest news, research collaborations, product updates, awards and grant-funded innovation projects.From scientific milestones to platform development, this is where we share how SymVentra continues to grow.","spans":[],"direction":"ltr"}],"milestones":[{"date":null,"title":[],"milestone_description":[],"author":null,"action_link":{"link_type":"Any"}}]},"id":"milestone_highlights$3cea9477-9154-45ce-95fa-938c72678133","slice_type":"milestone_highlights","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"section_heading":[{"type":"heading2","text":"NEWS & GRANTS","spans":[],"direction":"ltr"}],"section_description":[],"updates":[{"date_label":"Follow our journey","title":[],"description":[{"type":"paragraph","text":"Stay up to date with our latest news, research collaborations, product updates, awards and grant-funded innovation projects.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"From scientific milestones to platform development, this is where we share how SymVentra continues to grow.","spans":[],"direction":"ltr"}],"attribution":null,"external_link":{"link_type":"Any"}},{"date_label":"Every great innovation starts with a simple question.","title":[],"description":[{"type":"paragraph","text":"What if health advice could be as unique as the person receiving it?","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Inspired by years of microbiome research and a passion for preventive health, SymVentra began as an idea to make personalized health more accessible. Through entrepreneurship, scientific collaboration, customer validation and public innovation programmes, that idea gradually evolved into a growing health technology company. Along the way, we have been supported by leading innovation partners, secured competitive grants, expanded our multidisciplinary team and validated our platform in real-world settings.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Today, SymVentra is building the next generation of personalized health by combining biology, lifestyle and scientific evidence, helping people better understand themselves and make more informed choices for a healthier future.","spans":[],"direction":"ltr"}],"attribution":null,"external_link":{"link_type":"Any"}}]},"id":"featured_updates$5a26ac69-fadd-4df7-be76-87bd23497e4f","slice_type":"featured_updates","slice_label":null},{"variation":"three_column_simple","version":"initial","items":[],"primary":{"section_heading":[],"section_description":[],"timeline_items":[]},"id":"timeline_grid$d0426b92-7439-4408-848c-a3cd4baa2838","slice_type":"timeline_grid","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"section_heading":[{"type":"heading2","text":"Our Journey","spans":[],"direction":"ltr"}],"section_description":[{"type":"paragraph","text":"The progression and key venture milestones of SymVentra from research conception to deep tech validation.","spans":[],"direction":"ltr"}],"updates":[{"date_label":"September 2023","title":[{"type":"heading3","text":"Joining VentureLab North","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Founder and CEO Arezoo Shajiei-Schotsman began the VentureLab North entrepreneurship programme, initiating a year-long trajectory focused on customer discovery and target market validation.","spans":[],"direction":"ltr"}],"attribution":null,"external_link":{"link_type":"Any"}},{"date_label":"March 2024","title":[{"type":"heading3","text":"VentureLab Weekend Winner","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"The initial MicroHealth concept won the VentureLab Weekend cohort, securing early stage thesis validation and proving distinct market traction for AI-driven microbiome prevention tools.","spans":[],"direction":"ltr"}],"attribution":null,"external_link":{"link_type":"Any"}},{"date_label":"November 2024","title":[{"type":"heading3","text":"Completion of VentureLab North","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Following 12+ months of intensive training, MicroHealth completed its incubation structure, transforming formally from a conceptual research project into a validated startup framework.","spans":[],"direction":"ltr"}],"attribution":null,"external_link":{"link_type":"Any"}},{"date_label":"December 2024","title":[{"type":"heading3","text":"MKB Feasibility Voucher Awarded","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Secured the MKB Haalbaarheidsvoucher from SNN to explicitly study the technical, commercial, and stringent regulatory parameters of the core AI architecture.","spans":[],"direction":"ltr"}],"attribution":null,"external_link":{"link_type":"Any"}}]},"id":"featured_updates$bdd842b2-59f5-4266-aef3-c61b7ff6640f","slice_type":"featured_updates","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"eyebrow":"Secure Pilot Allocation","title":[{"type":"heading1","text":"Help shape the future of personalized biological health","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Secure Pilot Allocation","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Help shape the future of personalized biological health","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Register interest to enter the upcoming paid validation pilot cohort or request custom structural enterprise integration documentation.","spans":[],"direction":"ltr"}],"primary_cta":{"link_type":"Any","key":"d8025644-e6d4-4aab-8f2d-0abf9f53f4dc","text":"Join the Pilot Wait-list"},"secondary_cta":{"link_type":"Any","key":"93fe464b-9d90-41d5-9438-4bc805c360fa","text":"Explore Collaboration"}},"id":"cta_hero_banner$f2723c17-a52f-4184-a936-b06ed833a77d","slice_type":"cta_hero_banner","slice_label":null},{"variation":"logo_left_text_right","version":"initial","items":[],"primary":{"media":{"dimensions":{"width":262,"height":70},"alt":null,"copyright":null,"url":"https://images.prismic.io/cb704fc6/yVxROk9bVWFAZLEn_newlogo-1.png?auto=format,compress","id":"yVxROk9bVWFAZLEn","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"title":[{"type":"heading2","text":"Building the Future of Preventive Diagnostics","spans":[],"direction":"ltr"}],"description":[{"type":"paragraph","text":"Through intentional computation merging lifestyle data streams with advanced deep diagnostics, we design predictive tools enabling global populations to sustainably steer their longitudinal biology.","spans":[],"direction":"ltr"}]},"id":"media_side_intro$3957005a-054f-44ff-9bc1-577496d5438f","slice_type":"media_side_intro","slice_label":null},{"variation":"standard","version":"initial","items":[],"primary":{"columns":[{"type":"contact_info","heading":[{"type":"heading3","text