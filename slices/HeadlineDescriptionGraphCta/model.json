{
  "type": "SharedSlice",
  "id": "headline_description_graph_cta",
  "name": "HeadlineDescriptionGraphCta",
  "variations": [
    {
      "id": "default_left_text_right_metric",
      "name": "Left Text, Right Metric Card",
      "description": "Displays headline, subheadline, description, and two CTAs on the left, and a comprehensive metric/data visualization card with tags and recommendations on the right.",
      "version": "initial",
      "imageUrl": "",
      "docURL": "...",
      "primary": {
        "eyebrow": {
          "type": "StructuredText",
          "config": {
            "single": "paragraph,strong,em,hyperlink",
            "label": "Eyebrow"
          }
        },
        "headline": {
          "type": "StructuredText",
          "config": {
            "single": "heading1",
            "label": "Headline"
          }
        },
        "highlighted_phrase": {
          "type": "StructuredText",
          "config": {
            "single": "paragraph,strong",
            "label": "Highlighted Phrase"
          }
        },
        "description": {
          "type": "StructuredText",
          "config": {
            "multi": "paragraph,strong,em,hyperlink",
            "label": "Description"
          }
        },
        "primary_cta": {
          "type": "Link",
          "config": {
            "label": "Primary CTA",
            "allowText": true,
            "repeat": false,
            "select": null
          }
        },
        "secondary_cta": {
          "type": "Link",
          "config": {
            "label": "Secondary CTA",
            "allowText": true,
            "repeat": false,
            "select": null
          }
        },
        "metric_visualization_image": {
          "type": "Image",
          "config": {
            "label": "Metric Visualization Image"
          }
        },
        "metric_title": {
          "type": "StructuredText",
          "config": {
            "single": "heading3",
            "label": "Metric Title"
          }
        },
        "metrics_list": {
          "type": "Group",
          "config": {
            "label": "Metrics List",
            "fields": {
              "label": {
                "type": "Text",
                "config": {
                  "label": "Metric Label"
                }
              },
              "value": {
                "type": "Number",
                "config": {
                  "label": "Metric Value"
                }
              },
              "unit": {
                "type": "Text",
                "config": {
                  "label": "Metric Unit"
                }
              },
              "style": {
                "type": "Select",
                "config": {
                  "label": "Style",
                  "options": ["default", "critical", "highlighted"]
                }
              }
            }
          }
        },
        "tag_list": {
          "type": "Group",
          "config": {
            "label": "Tag List",
            "fields": {
              "label": {
                "type": "Text",
                "config": {
                  "label": "Tag Label"
                }
              },
              "color_scheme": {
                "type": "Select",
                "config": {
                  "label": "Color Scheme",
                  "options": ["default", "positive", "warning"]
                }
              }
            }
          }
        },
        "recommendation_text": {
          "type": "StructuredText",
          "config": {
            "multi": "paragraph,strong,em,hyperlink",
            "label": "Recommendation Text"
          }
        },
        "note": {
          "type": "Text",
          "config": {
            "label": "Note"
          }
        }
      }
    }
  ]
}
