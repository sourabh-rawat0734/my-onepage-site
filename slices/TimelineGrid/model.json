                  "label": "Date Label"
                }
              },
              "event_title": {
                "type": "StructuredText",
                "config": {
                  "single": "heading4",
                  "label": "Event Title"
                }
              },
              "event_description": {
                "type": "StructuredText",
                "config": {
                  "multi": "paragraph,strong,em,hyperlink,list-item",
